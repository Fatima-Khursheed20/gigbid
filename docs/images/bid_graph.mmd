---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	analyst(analyst)
	risk(risk)
	matcher(matcher)
	decide(decide)
	pricing(pricing)
	writer(writer)
	verifier(verifier)
	critic(critic)
	revise(revise)
	compliance(compliance)
	prepare_preview(prepare_preview)
	human_approval(human_approval)
	apply_edit(apply_edit)
	submit(submit)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	analyst --> decide;
	apply_edit --> compliance;
	compliance -.-> __end__;
	compliance -.-> prepare_preview;
	critic -.-> __end__;
	critic -.-> compliance;
	critic -.-> revise;
	decide -.-> __end__;
	decide -.-> pricing;
	human_approval -.-> __end__;
	human_approval -.-> apply_edit;
	human_approval -.-> submit;
	intake -.-> __end__;
	intake -.-> analyst;
	intake -.-> matcher;
	intake -.-> risk;
	matcher --> decide;
	prepare_preview -.-> __end__;
	prepare_preview -.-> human_approval;
	pricing -.-> __end__;
	pricing -.-> writer;
	revise --> writer;
	risk --> decide;
	verifier -.-> __end__;
	verifier -.-> critic;
	writer -.-> __end__;
	writer -.-> verifier;
	submit --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
