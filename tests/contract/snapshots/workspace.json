 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": false,
   "readOnlyHint": true
  },
  "description": "Free interview slots within working hours, spread across different days.",
  "inputSchema": {
   "properties": {
    "days": {
     "default": 5,
     "description": "How many working days ahead to search",
     "maximum": 14,
     "minimum": 1,
     "title": "Days",
     "type": "integer"
    },
    "duration_minutes": {
     "default": 30,
     "maximum": 120,
     "minimum": 15,
     "title": "Duration Minutes",
     "type": "integer"
    },
    "max_slots": {
     "default": 3,
     "maximum": 10,
     "minimum": 1,
     "title": "Max Slots",
     "type": "integer"
    },
    "start_date": {
     "anyOf": [
      {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Start Date"
    }
   },
   "title": "free_slotsArguments",
   "type": "object"
  },
  "name": "free_slots",
  "outputSchema": {
   "$defs": {
    "Slot": {
     "properties": {
      "end": {
       "title": "End",
       "type": "string"
      },
      "start": {
       "title": "Start",
       "type": "string"
      }
     },
     "required": [
      "start",
      "end"
     ],
     "title": "Slot",
     "type": "object"
    }
   },
   "properties": {
    "slots": {
     "items": {
      "$ref": "#/$defs/Slot"
     },
     "title": "Slots",
     "type": "array"
    },
    "timezone": {
     "title": "Timezone",
     "type": "string"
    }
   },
   "required": [
    "timezone",
    "slots"
   ],
   "title": "Slots",
   "type": "object"
  }
