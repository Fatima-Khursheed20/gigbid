  },
  "description": "Submit a draft to the client. Irreversible and spends Connects; only call after explicit human approval.\n    The idempotency key guarantees a retry never submits twice or spends Connects twice.",
  "inputSchema": {
   "properties": {
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Stable key for this logical action; retries with the same key are no-ops",
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 64,
     "minLength": 3,
     "title": "Job Id",
     "type": "string"
    },
    "proposal_id": {
     "maxLength": 64,
     "minLength": 3,
     "title": "Proposal Id",
     "type": "string"
    }
   },
   "required": [
    "proposal_id",
    "job_id",
    "idempotency_key"
   ],
   "title": "submit_proposalArguments",
   "type": "object"
  },
  "name": "submit_proposal",
  "outputSchema": {
   "properties": {
    "balance_after": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance After"
    },
    "balance_before": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Balance Before"
    },
    "connects_cost": {
     "title": "Connects Cost",
     "type": "integer"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotent_replay": {
     "default": false,
     "title": "Idempotent Replay",
     "type": "boolean"
    },
    "proposal_id": {
     "title": "Proposal Id",
     "type": "string"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "dry_run",
    "proposal_id",
    "connects_cost",
    "status"
   ],
   "title": "SubmitResult",
   "type": "object"
  }
