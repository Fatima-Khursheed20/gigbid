[
 {
  "annotations": {
   "destructiveHint": false,
   "idempotentHint": true,
   "openWorldHint": true,
   "readOnlyHint": false
  },
  "description": "Create a proposal DRAFT on the marketplace (free; nothing is sent to the client). dry_run returns the exact\n    payload and the Connects that submitting it would cost.",
  "inputSchema": {
   "properties": {
    "bid_amount": {
     "description": "USD total (fixed) or USD/hour (hourly)",
     "exclusiveMinimum": 0,
     "maximum": 100000,
     "title": "Bid Amount",
     "type": "number"
    },
    "bid_type": {
     "pattern": "^(fixed|hourly)$",
     "title": "Bid Type",
     "type": "string"
    },
    "cover_letter": {
     "maxLength": 5000,
     "minLength": 50,
     "title": "Cover Letter",
     "type": "string"
    },
    "dry_run": {
     "default": false,
     "title": "Dry Run",
     "type": "boolean"
    },
    "idempotency_key": {
     "description": "Stable key for this logical action; retries with the same key are no-ops",
     "maxLength": 128,
     "minLength": 8,
     "pattern": "^[A-Za-z0-9:_\\-.]+$",
     "title": "Idempotency Key",
     "type": "string"
    },
    "job_id": {
     "maxLength": 64,
     "minLength": 3,
     "title": "Job Id",
     "type": "string"
    },
    "screening_answers": {
     "default": [],
     "items": {
      "type": "string"
     },
     "maxItems": 10,
     "title": "Screening Answers",
     "type": "array"
    }
   },
   "required": [
    "job_id",
    "cover_letter",
    "bid_amount",
    "bid_type",
    "idempotency_key"
   ],
   "title": "create_proposal_draftArguments",
   "type": "object"
  },
  "name": "create_proposal_draft",
  "outputSchema": {
   "properties": {
    "connects_cost": {
     "description": "Connects that SUBMITTING this draft will cost (drafts are free)",
     "title": "Connects Cost",
     "type": "integer"
    },
    "dry_run": {
     "title": "Dry Run",
     "type": "boolean"
    },
    "proposal_id": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Proposal Id"
    },
    "status": {
     "title": "Status",
     "type": "string"
    },
    "would_send": {
     "additionalProperties": true,
     "title": "Would Send",
     "type": "object"
    }
   },
   "required": [
    "dry_run",
    "would_send",
    "connects_cost",
    "status"
   ],
   "title": "DraftResult",
   "type": "object"
  }
 },
