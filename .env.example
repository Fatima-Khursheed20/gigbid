# ---- copy to .env and fill in; never commit .env ----
APP_ENV=development
# 32+ random chars; used to sign sessions and derive the token-encryption key
APP_SECRET_KEY=change-me-to-a-long-random-string
# Optional explicit Fernet key for the OAuth token store (else derived from APP_SECRET_KEY)
TOKEN_ENCRYPTION_KEY=

# ---- datastores ----
DATABASE_URL=postgresql://gigbid:gigbid@localhost:5432/gigbid
REDIS_URL=redis://localhost:6379/0

# ---- marketplace ----
# gigsim | upwork
MARKETPLACE_MODE=gigsim
GIGSIM_BASE_URL=http://localhost:8081
GIGSIM_ADMIN_TOKEN=gigsim-admin
GIGSIM_POLICY_VERSION=v1
GIGSIM_ERROR_RATE=0.03
GIGSIM_RATE_LIMIT_PER_MIN=60

# ---- MCP servers (streamable HTTP) ----
MCP_PORTFOLIO_URL=http://localhost:8101/mcp
MCP_MARKETPLACE_URL=http://localhost:8102/mcp
MCP_WORKSPACE_URL=http://localhost:8103/mcp
# bearer token the agent presents to the marketplace MCP server
MCP_MARKETPLACE_TOKEN=change-me

# ---- models ----
# open (required) | paid (optional)
MODEL_PROFILE=open
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# set to 1 in CI/unit tests to use the deterministic offline model
LLM_OFFLINE=0

# ---- tracing (LangSmith) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid

# ---- third-party MCP ----
# GitHub MCP server (read-only fine-grained PAT is enough)
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_PERSONAL_ACCESS_TOKEN=
# Upwork official MCP server (live mode, OAuth 2.1)
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_OAUTH_REDIRECT_URL=http://localhost:8000/api/auth/upwork/callback

# ---- data prep (optional) ----
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- reviewer account seeded at startup (set real values only in the host's secret store) ----
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
